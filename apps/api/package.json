{
  "name": "stiftelsen-effekt-backend",
  "version": "0.0.1",
  "description": "Backend for stiftelsen gi effektivt sitt donasjonsystem",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:types": "node scripts/build-types.mjs",
    "build": "copyfiles -u 1 src/static/* src/views/**/* src/views/**/**/* src/views/**/**/**/* dist/ && tsc -p tsconfig.build.json",
    "start": "node ./dist/server.js",
    "dev": "cross-env NODEMON=true NODE_ENV=development nodemon src/server.ts",
    "dev-windows": "cross-env NODEMON=true nodemon src/server.ts",
    "debug": "cross-env NODEMON=true nodemon --exec 'node --inspect=0.0.0.0:9229 --require ts-node/register src/server.ts'",
    "postinstall": "prisma generate",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "oxlint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stiftelsen-effekt/effekt-platform.git"
  },
  "author": "Håkon Harnes",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/stiftelsen-effekt/effekt-platform/issues"
  },
  "homepage": "https://github.com/stiftelsen-effekt/effekt-platform#readme",
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@navikt/fnrvalidator": "^2.2.1",
    "@prisma/client": "^7.10.1",
    "@trpc/server": "catalog:",
    "@types/luxon": "catalog:",
    "@types/ssh2-sftp-client": "^9.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "apicache": "1.6.3",
    "compression": "^1.8.2",
    "csv-parse": "catalog:",
    "decimal.js": "^10.6.0",
    "dotenv": "catalog:",
    "express": "^5.3.0",
    "express-bearer-token": "^3.0.0",
    "express-fileupload": "^1.5.2",
    "express-oauth2-jwt-bearer": "1.11.0",
    "express-prettify": "0.1.2",
    "express-rate-limit": "^8.7.1",
    "honeypot": "0.0.2",
    "ioredis": "^6.0.0",
    "luxon": "catalog:",
    "mailersend": "^3.4.1",
    "moment": "^2.31.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "norwegian-workdays": "catalog:",
    "prisma": "^7.10.1",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9",
    "sqlstring": "^2.3.1",
    "ssh2-sftp-client": "^12.1.1",
    "ts-node": "^10.4.0",
    "ws": "^8.22.0",
    "xmllint-wasm": "^5.3.0",
    "xpath": "^0.0.35",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effekt/config": "workspace:*",
    "@types/chai": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "1.5.1",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "catalog:",
    "@types/qs": "6.15.1",
    "@types/request-promise-native": "^1.0.17",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "catalog:",
    "chai": "^6.3.0",
    "chai-datetime": "^1.7.0",
    "copyfiles": "^2.4.1",
    "cross-env": "catalog:",
    "nodemon": "^3.1.14",
    "oxlint": "catalog:",
    "sinon": "^22.1.0",
    "ssh2": "1.17.0",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
